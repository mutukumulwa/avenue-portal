model Group {
  currency                  String              @default("UGX") // G3.5 multi-currency (base UGX)
  id                        String              @id @default(cuid())
  tenantId                  String
  tenant                    Tenant              @relation(fields: [tenantId], references: [id])
  // Client payer that owns this scheme (G2.1). Required: every scheme belongs to
  // exactly one client. All create paths resolve it via resolveSchemeClientId()
  // (confined/selected client, else the operator tenant's default client).
  clientId                  String
  client                    Client              @relation(fields: [clientId], references: [id])
  name                      String
  // Normalized legal-name key for CLIENT-scoped case/space/Unicode-insensitive
  // duplicate detection (SP-3 / WP-S1). Computed via normalizeLegalName() on every
  // scheme create + rename. `@default("")` lets `db push` add the column to
  // existing rows; the `@@unique([clientId, nameNormalized])` below is a DEPLOY
  // step gated on a CLEAN collision report + backfill first
  // (scripts/uat/report-group-name-collisions.ts then
  // scripts/uat/backfill-group-name-normalized.ts) — plan §7.1 (a constraint
  // ships only after its report is clean).
  nameNormalized            String              @default("")
  industry                  String?
  registrationNumber        String?
  contactPersonName         String
  contactPersonPhone        String
  contactPersonEmail        String
  address                   String?
  county                    String?
  packageId                 String
  package                   Package             @relation(fields: [packageId], references: [id])
  packageVersionId          String?
  packageVersion            PackageVersion?     @relation(fields: [packageVersionId], references: [id])
  brokerId                  String?
  broker                    Broker?             @relation(fields: [brokerId], references: [id])
  producers                 BrokerProducer[]    @relation("ProducerSchemes")
  paymentFrequency          PaymentFrequency    @default(ANNUAL)
  contributionRate          Decimal // Per-member contribution amount
  effectiveDate             DateTime
  renewalDate               DateTime
  status                    GroupStatus         @default(PENDING)
  suspendedAt               DateTime?
  suspensionReason          String?
  terminatedAt              DateTime?
  notes                     String?
  clientType                ClientType          @default(CORPORATE)
  // ── Process 11: Renewal lifecycle ─────────────────────────
  renewalStatus             GroupRenewalStatus? // pipeline status
  supersededByGroupId       String? // points to the successor Group on renewal
  renewalNoticeDispatchedAt DateTime? // when the 60-day notice was sent
  priorPeriodReconciled     Boolean             @default(false) // block binding until settled
  // Funding mode — INSURED (default) or SELF_FUNDED
  fundingMode               FundingMode         @default(INSURED)
  // Self-funded admin fee config (ignored when fundingMode = INSURED)
  adminFeeMethod            AdminFeeMethod?
  adminFeeRate              Decimal? // KES flat (FLAT_PER_INSURED) or % (PCT_OF_CLAIMS)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  members            Member[]
  benefitTiers       GroupBenefitTier[]
  endorsements       Endorsement[]       @relation("EndorsementGroup")
  inboundTransfers   Endorsement[]       @relation("EndorsementToGroup")
  fundAdministrators User[]              @relation("FundAdminGroups")
  invoices           Invoice[]
  payments           Payment[]
  documents          Document[]
  activityLogs       ActivityLog[]
  quotations         Quotation[]
  hrManagers         User[]              @relation("HRManagerGroup")
  serviceRequests    ServiceRequest[]
  selfFundedAccount  SelfFundedAccount?
  adminFeeAgreements AdminFeeAgreement[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, fundingMode])
  @@index([brokerId])
  @@index([clientId])
  // WP-S1 — CLIENT-scoped scheme-name uniqueness (S-002: two clients may each run
  // a "Staff Medical Scheme"; one client may not). DEPLOY-GATED: apply only after
  // scripts/uat/report-group-name-collisions.ts is clean AND
  // scripts/uat/backfill-group-name-normalized.ts has run (plan §7.1).
  @@unique([clientId, nameNormalized])
  // WP-S1 — registration number unique per tenant where present. NULLs don't
  // collide (schemes without one are unaffected); tenant scoping keeps two
  // tenants' individual IND-NNNNN refs from cross-colliding. DEPLOY-GATED behind
  // scripts/uat/report-group-registration-collisions.ts.
  @@unique([tenantId, registrationNumber])
}

