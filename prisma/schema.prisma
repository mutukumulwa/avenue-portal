}

// ─── DOMAIN EVENTS (UAT-HF P01.03) ──────────────────────
//
// The immutable record of what actually happened, written in the SAME transaction
// as the state change and its operation receipt.
//
// The run's sharpest example is DEF-040: "Standard Cancel" terminated a member on
// one unconfirmed click and computed a refund of UGX 1,196,212.33 — and the member's
// Activity Log still read "No activity recorded yet." The termination and the money
// were absent from the trail. The cause is structural: lifecycle writes go to the
// audit-chain model while the member page reads ActivityLog, so the two never meet
// (DEF-045, DEF-048, DEF-059, DEF-081 are the same shape).
//
// Fixing it by writing ActivityLog directly would just move the problem. Instead a
// command records ONE event transactionally, and a projector fans it out into the
// activity log and the notification outbox afterwards. State can therefore never
// commit without its event, and a failed projection is visible and replayable
// rather than silently lost.

enum DomainEventProjectionState {
  /// Recorded, not yet fanned out.
  PENDING
  /// Projected into the activity log (and notifications, where applicable).
  PROJECTED
  /// Projection failed repeatedly; needs attention. Never silently dropped.
  FAILED
}

model DomainEvent {
  id       String @id @default(cuid())
  tenantId String

  /// Dotted, stable name, e.g. "member.lifecycle.terminated".
  eventType String

  entityType String
  entityId   String
  /// Quotable business reference, e.g. "UX26-2026-00017". Never PII.
  entityRef String?

  // Denormalised actor identity. DEF-047 found the endorsement panel showing a raw
  // internal id ("Maker cmsoxn5j0002tbpvqg8gomey4"); an audit trail has to survive
  // the actor being renamed or deactivated, so the display name is captured here.
  actorId   String?
  actorName String?
  actorRole String?

  /// One human sentence, written by the command that recorded the event, e.g.
  /// "Cover terminated with effect from 31 Aug 2026 (last covered day)." This is
  /// what the activity log shows. It is part of the immutable record because the
  /// run's complaint was not that text was wrong but that it was absent.
  description String

  /// When the change took business effect. May differ from createdAt.
  occurredAt DateTime @default(now())

  /// The command, or before/after. Immutable — see the trigger in the migration.
  payload Json

  /// Why. DEF-040/041 found lifecycle transitions firing with no reason at all.
  reasonCode String?
  reasonNote String?

  correlationId      String?
  operationReceiptId String?

  projectionState    DomainEventProjectionState @default(PENDING)
  projectedAt        DateTime?
  projectionAttempts Int                        @default(0)
  projectionError    String?

  createdAt DateTime @default(now())

  activityLog ActivityLog?

  @@index([tenantId, entityType, entityId, occurredAt])
  @@index([projectionState, createdAt])
  @@index([tenantId, eventType, occurredAt])
}

// ─── OPERATION RECEIPTS (UAT-HF P01.02) ─────────────────
//
// One row per *intended business effect*, reserved BEFORE the write and completed
// in the same transaction as it. This is what makes "did my submit land?"
// answerable at all.
//
// DEF-065: a dropped response destroyed the operator's input and hid a write that
// HAD committed — the server returned 200 and created UX26-2026-00037 while the
// screen showed only a crash. DEF-034: a double-click silently discarded an
// enrolment. DEF-068: a dropped import confirm left no way to learn the outcome.
// All three are the same missing thing: a durable record of intent, keyed by
// something the client chose before it sent anything.

enum OperationReceiptState {
  /// Reserved; the command has not started work yet.
  RECEIVED
  /// The command is running. A second submit arriving here must NOT write again.
  PROCESSING
  /// Committed. A replay returns the stored reference instead of writing.
  SUCCEEDED
  /// Provably did not commit. The same key may be retried.
  FAILED
  /// We cannot tell. Never auto-retried; requires a human or a reconciliation job.
  UNKNOWN
}

model OperationReceipt {
  id String @id @default(cuid())

  // Deliberately plain columns, not relations. AuditLog's User foreign key is
  // RESTRICT, which is why the UAT run could not delete its 17 personas without
  // destroying 72 audit rows. A receipt must never become a reason a tenant or
  // user cannot be removed, and it outlives both by design.
  tenantId String
  actorId  String

  /// Stable command name, e.g. "members.create". Part of the idempotency key.
  operationType String
  /// Chosen by the CLIENT before the first attempt and resent on every retry.
  idempotencyKey String
  /// SHA-256 of the canonicalised request. Same key + different hash = conflict.
  requestHash String

  state OperationReceiptState @default(RECEIVED)

  /// What the command affected, once known.
  entityType String?
  entityId   String?
  /// Quotable business reference, e.g. "UX26-2026-00017". Never PII.
  entityRef String?

  /// Safe, non-PII outcome code for support and dashboards, e.g. "CONFLICT".
  resultCode String?
  /// The attempt's correlation id, tying this row to the server logs.
  correlationId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  /// The idempotency boundary: one actor's one named intent, once.
  @@unique([tenantId, actorId, operationType, idempotencyKey])
  @@index([tenantId, state, createdAt])
  @@index([tenantId, entityType, entityId])
}

