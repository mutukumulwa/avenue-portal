// ── Cross-border / overseas care coordination (Medvex spec §5.15 / gap G5.15) ──
// AD-8 cross-border employee-benefits play. A coordination layer that sits on
// top of client pre-auth: vetted-facility sourcing → upfront estimate →
// GOP-within-limits commitment → single consolidated, audit-ready invoice.
// Foreign amounts are FX-normalised to the base currency (UGX, G3.5) at each
// step so limits, GOPs and invoices are all comparable and reportable. A
// per-case CROSS_BORDER coordination fee (G2.3) accrues on settlement.
enum CrossBorderCaseStatus {
  SOURCING // facility being sourced/vetted; no estimate yet
  ESTIMATED // upfront estimate captured & FX-normalised
  GOP_ISSUED // guarantee of payment committed within limits
  IN_TREATMENT // member receiving care
  INVOICED // consolidated invoice raised
  SETTLED // paid & coordination fee accrued
  CANCELLED // abandoned (never deleted)
}

enum CrossBorderLineKind {
  ESTIMATE // pre-treatment cost estimate line
  INVOICE // post-treatment consolidated-invoice line
}

// A vetted overseas/cross-border facility Medvex can steer cases to. Never
// deleted — retired facilities are closed with `effectiveTo` / `isActive`.
model CrossBorderFacility {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  country       String // ISO country name (e.g. "India", "Kenya", "South Africa")
  city          String?
  currency      String   @default("UGX") // facility's billing currency
  specialties   String[] // e.g. ["Oncology", "Cardiac Surgery"]
  accreditation String? // e.g. "JCI", "NABH"
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  notes         String?
  isVetted      Boolean  @default(false) // passed Medvex clinical/commercial vetting

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cases CrossBorderCase[]

  @@index([tenantId, isActive])
  @@index([tenantId, country])
}

// A single cross-border coordination episode for one member. Carries the FX
// snapshots for the estimate, the GOP commitment and the final invoice so the
// audit trail is self-contained.
model CrossBorderCase {
  id         String               @id @default(cuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  clientId   String // the paying client (payer)
  client     Client               @relation(fields: [clientId], references: [id])
  memberId   String
  member     Member               @relation(fields: [memberId], references: [id])
  facilityId String?
  facility   CrossBorderFacility? @relation(fields: [facilityId], references: [id])
  preauthId  String? // links into client pre-auth when coordinated from there

  caseNumber       String
  diagnosis        String
  treatmentSummary String?
  status           CrossBorderCaseStatus @default(SOURCING)

  // Estimate snapshot (base = UGX)
  estimatedAmount    Decimal?
  estimatedCurrency  String?
  estimatedAmountUgx Decimal?

  // GOP commitment snapshot (base = UGX) + limit check
  gopAmount        Decimal?
  gopCurrency      String?
  gopAmountUgx     Decimal?
  approvedLimitUgx Decimal? // member/benefit limit the GOP was checked against
  gopWithinLimit   Boolean? // true when gopAmountUgx <= approvedLimitUgx

  // Consolidated invoice snapshot
  invoiceReference String?
  invoiceTotalUgx  Decimal?
  invoicedAt       DateTime?
  settledAt        DateTime?

  adminFeeLedgerEntryId String? // CROSS_BORDER coordination fee accrued at settlement
  createdById           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems CrossBorderLineItem[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([memberId])
  @@index([facilityId])
}

// Estimate and consolidated-invoice lines for a case, each FX-normalised to UGX
// at capture. The single consolidated invoice = the sum of kind=INVOICE lines.
model CrossBorderLineItem {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  caseId      String
  case        CrossBorderCase     @relation(fields: [caseId], references: [id])
  kind        CrossBorderLineKind
  description String
  serviceDate DateTime?
  amount      Decimal
  currency    String
  fxRate      Decimal             @default(1) // rate used: amountUgx = amount × fxRate
  amountUgx   Decimal

  createdAt DateTime @default(now())

  @@index([caseId, kind])
  @@index([tenantId])
}

// ── Preventative care & wellness (Medvex spec §5.16 / gap G5.16) ───────────────
// AD-9 loss-ratio countermeasure. Three pillars in one configurable module:
//  • SCREENING — funded preventative checks configured into covers, recurring on
//    a cadence (annual health check, cervical/mammogram screening, etc.).
//  • CHRONIC_DISEASE_MGMT — enrolment into a managed protocol for target
//    conditions (diabetes, hypertension) with periodic checkpoints.
//  • INCENTIVE — activity tracking / gamification; members earn points that the
//    scheme can reward (premium discount, wellness credits).
// Members enrol into programmes; activities are logged against enrolments,
// awarding points and (for screenings) advancing the next-due date. Analytics
// feed the loss-ratio story.
enum WellnessProgramType {
  SCREENING // recurring funded preventative check
  CHRONIC_DISEASE_MGMT // managed protocol for a target condition
  INCENTIVE // activity/gamification points programme
}

enum WellnessEnrollmentStatus {
  ACTIVE
  COMPLETED // one-off screening done, or protocol graduated
  WITHDRAWN // member opted out (never deleted)
  LAPSED // missed the due window
}

enum WellnessActivityType {
  SCREENING_COMPLETED
  HEALTH_CHECK
  VITALS_LOGGED
  IMMUNIZATION
  COACHING_SESSION
  PHYSICAL_ACTIVITY
  OTHER
}

// A configurable wellness programme. Client-scoped when clientId is set,
// otherwise operator-wide. Never deleted — retire via effectiveTo / isActive.
model WellnessProgram {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  clientId String? // null = operator-wide default
  client   Client? @relation(fields: [clientId], references: [id])

  name        String
  type        WellnessProgramType
  description String?

  // SCREENING/CDM: months between checkpoints (null = one-off).
  cadenceMonths    Int?
  // SCREENING: amount funded into the cover per occurrence (FX per currency).
  fundedAmount     Decimal?
  currency         String   @default("UGX")
  // CHRONIC_DISEASE_MGMT: conditions this protocol manages.
  targetConditions String[]
  // INCENTIVE: default points awarded per qualifying activity.
  pointsReward     Int      @default(0)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments WellnessEnrollment[]

  @@index([tenantId, isActive])
  @@index([tenantId, clientId])
  @@index([tenantId, type])
}

// A member's enrolment into a programme. One active enrolment per member+program.
model WellnessEnrollment {
  id        String                   @id @default(cuid())
  tenantId  String
  tenant    Tenant                   @relation(fields: [tenantId], references: [id])
  programId String
  program   WellnessProgram          @relation(fields: [programId], references: [id])
  memberId  String
  member    Member                   @relation(fields: [memberId], references: [id])
  status    WellnessEnrollmentStatus @default(ACTIVE)

  enrolledAt     DateTime  @default(now())
  nextDueDate    DateTime? // next checkpoint (screenings/CDM)
  lastActivityAt DateTime?
  completedAt    DateTime?
  pointsEarned   Int       @default(0)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities WellnessActivity[]

  @@unique([tenantId, programId, memberId])
  @@index([tenantId, status])
  @@index([tenantId, nextDueDate])
  @@index([memberId])
}

// A logged wellness activity against an enrolment (drives points + due dates).
model WellnessActivity {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  enrollmentId  String
  enrollment    WellnessEnrollment   @relation(fields: [enrollmentId], references: [id])
  memberId      String
  member        Member               @relation(fields: [memberId], references: [id])
  type          WellnessActivityType
  description   String?
  activityDate  DateTime             @default(now())
  pointsAwarded Int                  @default(0)
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([enrollmentId])
  @@index([tenantId, memberId])
}

// ═══════════════════════════════════════════════════════════════════════════
// CLAIMS AUTOPILOT — canonical intake receipt (F2.1, plan §9.1–§9.2)
// Durable, payload-safe idempotency receipt: one row per intake attempt under a
// (tenant, scopeKey, channel, idempotencyKey) uniqueness boundary. Stores hashes
// and safe outcomes only — never raw payloads/credentials/clinical text (D16).
// ═══════════════════════════════════════════════════════════════════════════

enum ClaimIntakeChannel {
  ADMIN_PORTAL
  PROVIDER_PORTAL
  API_V1
  TRPC
  CSV_IMPORT
  OFFLINE_SYNC
  REIMBURSEMENT
  PREAUTH_CONVERSION
  CASE_INTERIM
  CASE_FINAL
  SMART
  SLADE360
}

enum ClaimIntakeReceiptState {
  PROCESSING
  SUCCEEDED
  REJECTED
  FAILED
}

model ClaimIntakeReceipt {
  id                            String                  @id @default(cuid())
  tenantId                      String
  tenant                        Tenant                  @relation(fields: [tenantId], references: [id])
  // Server-derived idempotency scope (user:<id> / provider:<id> / device:<p>:<d>
  // / case:<id> / preauth:<id> / reimbursement:<m> / integration:<key>).
  scopeKey                      String
  channel                       ClaimIntakeChannel
  idempotencyKey                String
  schemaVersion                 String
  // SHA-256 of canonical claim-affecting content (prefixed req:v1:).
  requestHash                   String
  // Authoritative identity hash (strong:v1:) — null when no authoritative id.
  strongEventFingerprint        String?
  // Non-unique content signature (suspect:v1:) — candidate detection only.
  suspectedDuplicateFingerprint String
  // At most one claim per receipt; a claim may have many receipts (cross-rail link).
  claimId                       String?
  claim                         Claim?                  @relation(fields: [claimId], references: [id])
  state                         ClaimIntakeReceiptState @default(PROCESSING)
  outcomeCode                   String? // stable INTAKE_CODES / route code
  safeMessage                   String? // caller-safe message; never raw internals
  httpStatus                    Int?
  correlationId                 String
  processingRuns                ClaimProcessingRun[]
  // Set when this receipt replayed/linked to an earlier receipt (plain ref, no FK
  // self-relation to keep queries simple).
  replayedFromReceiptId         String?
  createdAt                     DateTime                @default(now())
  completedAt                   DateTime?
  updatedAt                     DateTime                @updatedAt

  @@unique([tenantId, scopeKey, channel, idempotencyKey])
  @@index([tenantId, strongEventFingerprint])
  @@index([tenantId, suspectedDuplicateFingerprint])
  @@index([tenantId, state, createdAt])
  @@index([claimId])
}

// ═══════════════════════════════════════════════════════════════════════════
// CLAIMS AUTOPILOT — durable processing run + stage history (F2.3, §9.3–§9.4)
// Database is authoritative (D8): the run/stage rows are the source of truth for
// automated evaluation; BullMQ only accelerates execution.
// ═══════════════════════════════════════════════════════════════════════════

enum ClaimProcessingTrigger {
  INITIAL
  MANUAL_REPROCESS
  DUPLICATE_CLEARED
  DOCUMENTS_UPDATED
  CONFIG_CHANGED
  RECOVERY
}

enum ClaimProcessingState {
  PENDING
  RUNNING
  ROUTED
  SHADOW_COMPLETE
  AUTO_DECIDED
  RETRYABLE
  FAILED
}

enum ClaimProcessingStageName {
  CONTEXT
  ELIGIBILITY
  CODING
  DOCUMENTS
  DUPLICATE
  CLINICAL // Diagnosis Gate protocol-adherence stage (DG C2.1) — runs before CONTRACT
  CONTRACT
  PREAUTH
  BENEFIT
  FRAUD
  COST_SHARE
  POLICY
  DECISION
  NOTIFICATION
  AUDIT
}

enum ClaimProcessingStageState {
  PENDING
  RUNNING
  PASSED
  ROUTED
  SKIPPED
  RETRYABLE
  FAILED
}

model ClaimProcessingRun {
  id              String                    @id @default(cuid())
  tenantId        String
  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  claimId         String
  claim           Claim                     @relation(fields: [claimId], references: [id])
  receiptId       String
  receipt         ClaimIntakeReceipt        @relation(fields: [receiptId], references: [id])
  claimRevision   Int                       @default(1)
  workflowVersion String                    @default("v1")
  sequence        Int                       @default(1) // 1 = initial; authorized reprocess increments
  trigger         ClaimProcessingTrigger    @default(INITIAL)
  supersedesRunId String? // terminal run this reprocess supersedes
  modeResolved    String? // resolved OFF/SHADOW/LIVE (text — decoupled from the policy enum)
  policyId        String?
  state           ClaimProcessingState      @default(PENDING)
  currentStage    ClaimProcessingStageName?
  routeCode       String?
  assignedQueue   String?
  safeMessage     String? // no raw stack/payload
  attemptCount    Int                       @default(0)
  nextAttemptAt   DateTime?
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  stages ClaimProcessingStage[]

  // At most one run per (claim revision, workflow, sequence).
  @@unique([claimId, claimRevision, workflowVersion, sequence])
  @@index([tenantId, state, nextAttemptAt])
  @@index([tenantId, assignedQueue, state])
  @@index([claimId])
  @@index([receiptId])
}

model ClaimProcessingStage {
  id           String                    @id @default(cuid())
  runId        String
  run          ClaimProcessingRun        @relation(fields: [runId], references: [id])
  stage        ClaimProcessingStageName
  state        ClaimProcessingStageState @default(PENDING)
  attemptCount Int                       @default(0)
  reasonCode   String?
  safeMessage  String?
  result       Json? // safe machine-readable refs/totals only — never raw docs/credentials
  durationMs   Int?
  startedAt    DateTime?
  completedAt  DateTime?
  updatedAt    DateTime                  @updatedAt

  @@unique([runId, stage])
}

// ═══════════════════════════════════════════════════════════════════════════
// CLAIMS AUTOPILOT — governed automation policy mode/status (F2.4, §9.1/§9.6)
// Every scope starts OFF (D1/D2). LIVE requires an APPROVED policy version and a
// finite positive ceiling; activation is maker-checker governed (D15, F2.5).
// ═══════════════════════════════════════════════════════════════════════════

enum AutoAdjudicationMode {
  OFF
  SHADOW
  LIVE
}

enum AutoAdjudicationPolicyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
  DEACTIVATED
}

// ═══════════════════════════════════════════════════════════════════════════
// CLAIMS AUTOPILOT — circuit breaker (F4.7, §13.3). Ops can stop LIVE automatic
// decisions per tenant/client immediately without deleting policy history; a
// critical invariant/failure can trip it automatically. History is preserved via
// audit-chain events (AUTO_ADJ:CIRCUIT_BREAKER_OPENED/CLOSED).
// ═══════════════════════════════════════════════════════════════════════════
model ClaimAutopilotBreaker {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  clientId      String? // null = tenant-wide breaker
  isOpen        Boolean   @default(false)
  reason        String?
  autoTriggered Boolean   @default(false)
  openedById    String?
  openedAt      DateTime?
  closedById    String?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, clientId])
  @@index([tenantId, isOpen])
}

// ─── PNOS F5.11 — Reconsideration (spec §7.8 / D13) ──────────────────────────
// A governed review case challenging a decided claim/line. Submitting a
// reconsideration does NOT mutate the original claim's status or money (D13); the
// case carries its own eligibility, reason, deadline, line targets, evidence,
// reviewer, SLA, and outcome. Satellites are relation-less to Claim/ClaimLine
// (String ids + indexes) so the schema change stays additive, exactly like the
// F3.2 PreAuthorizationEvent / F4.1 PreauthInfoRequest satellites. Documents attach
// via the existing DocumentUploadIntent generic target (targetType RECONSIDERATION).

enum ReconsiderationStatus {
  DRAFT
  SUBMITTED
  TRIAGE
  INFORMATION_REQUIRED
  PROVIDER_RESPONDED
  UNDER_REVIEW
  ACCEPTED
  PARTIALLY_ACCEPTED
  UPHELD
  WITHDRAWN
  CLOSED
}

model ClaimReconsideration {
  id                     String                @id @default(cuid())
  tenantId               String
  clientId               String? // payer scope, for read-model confinement (G2.1)
  providerId             String
  providerBranchId       String?
  // The decided claim under dispute + its submission chain root (F5.2). Relation-less.
  claimId                String
  chainRootClaimId       String?
  // Filing reason (catalog code, F5.11 policy) + the provider's narrative.
  reasonCode             String
  providerNarrative      String
  // Requested additional amount (the provider's ask) + currency (must match the claim).
  requestedAmount        Decimal               @default(0) @db.Decimal(14, 2)
  currency               String
  // Deadline resolution (F5.11 policy) + filing time.
  filingDeadline         DateTime?
  filedAt                DateTime?
  status                 ReconsiderationStatus @default(DRAFT)
  // Triage / assignment. originalAdjudicatorId drives the separation-of-duty warning.
  assignedTeam           String?
  assignedReviewerId     String?
  originalAdjudicatorId  String?
  // Outcome — SAFE (provider-facing) vs INTERNAL are separated (§9); the provider
  // projection (F5.11 policy) never exposes outcomeInternalNotes / internal refs.
  outcomeReasonCode      String?
  outcomeSafeExplanation String?
  outcomeInternalNotes   String?
  // Set only when an accepted outcome spawns a linked resubmission/supplemental claim (F5.16).
  supplementalClaimId    String?
  // SLA policy/version + due time (event history is the ClaimReconsiderationEvent relation).
  slaPolicy              String?
  slaVersion             String?
  dueAt                  DateTime?
  // Optimistic concurrency + idempotent submit (F5.11 step 6).
  idempotencyKey         String?
  version                Int                   @default(1)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  lines  ClaimReconsiderationLine[]
  events ClaimReconsiderationEvent[]

  @@unique([tenantId, idempotencyKey]) // NULLs distinct in PG ⇒ keyless drafts unaffected
  @@index([tenantId, claimId])
  @@index([tenantId, status])
  @@index([tenantId, providerId])
  @@index([tenantId, clientId])
}

model ClaimReconsiderationLine {
  id                           String               @id @default(cuid())
  reconsiderationId            String
  reconsideration              ClaimReconsideration @relation(fields: [reconsiderationId], references: [id])
  // The disputed original claim line (relation-less; must belong to the case's claim, F5.11 test).
  claimLineId                  String
  disputedCategory             String?
  narrative                    String?
  // Frozen snapshot of the original line economics (§7.8 / PNO-REC-003 recon check).
  originalBilled               Decimal              @default(0) @db.Decimal(14, 2)
  originalAllowed              Decimal              @default(0) @db.Decimal(14, 2)
  originalPayable              Decimal              @default(0) @db.Decimal(14, 2)
  originalMemberShare          Decimal              @default(0) @db.Decimal(14, 2)
  originalWriteoff             Decimal              @default(0) @db.Decimal(14, 2)
  // The provider's requested corrected amounts.
  requestedAllowed             Decimal?             @db.Decimal(14, 2)
  requestedPayable             Decimal?             @db.Decimal(14, 2)
  // The reviewer's corrected FULL entitlement (through the pricing/benefit components, F5.15).
  reviewerCorrectedEntitlement Decimal?             @db.Decimal(14, 2)
  // Prior settlement facts + the hard ceiling for the incremental award.
  alreadyApproved              Decimal              @default(0) @db.Decimal(14, 2)
  alreadyPaid                  Decimal              @default(0) @db.Decimal(14, 2)
  maxIncrement                 Decimal              @default(0) @db.Decimal(14, 2) // = max(0, correctedEntitlement − max(approved, paid))
  awardedIncrement             Decimal              @default(0) @db.Decimal(14, 2) // 0 ≤ awarded ≤ maxIncrement (F5.11 invariant)
  outcomeReasonCode            String?
  createdAt                    DateTime             @default(now())

  @@index([reconsiderationId])
  @@index([claimLineId])
}

model ClaimReconsiderationEvent {
  id                String               @id @default(cuid())
  tenantId          String
  reconsiderationId String
  reconsideration   ClaimReconsideration @relation(fields: [reconsiderationId], references: [id])
  sequence          Int
  eventType         String // SUBMITTED | TRIAGED | ASSIGNED | INFO_REQUESTED | PROVIDER_RESPONDED | UNDER_REVIEW | OUTCOME_RECORDED | ACCEPTED | PARTIALLY_ACCEPTED | UPHELD | WITHDRAWN | CLOSED …
  priorStatus       String?
  newStatus         String?
  // Provider-safe code vs a POINTER to internal detail — never the detail itself (§9).
  safeReasonCode    String?
  internalReasonRef String?
  // Safe message text for the structured info-request / provider-response exchange.
  message           String?
  actorType         String
  actorId           String?
  dataVersionRef    String?
  metadata          Json? // SAFE metadata only (validated before write)
  createdAt         DateTime             @default(now())

  @@unique([reconsiderationId, sequence])
  @@index([tenantId, reconsiderationId, createdAt])
}

// PNOS F6.7 — actual provider payment facts (§7.9), DISTINCT from the voucher/batch
// (which authorize/represent payment). D16: "paid" as a bank fact lives here, not on
// the batch. Relation-less id pointers (satellite convention, F3.2/F5.11) so no
// ProviderSettlementBatch/PaymentVoucher model churn. NO @@unique on settlementBatchId:
// one batch normally has ONE disbursement, but split/partial disbursements are allowed
// (§I5); the idempotencyKey unique is what prevents a duplicate same-key record.
enum DisbursementStatus {
  PENDING // recorded, not yet released
  RELEASED // authorized for payment (maker→checker)
  PROCESSING // sent to the bank/channel
  SUCCEEDED // channel-confirmed actual payment
  FAILED // terminal — a retry is a NEW disbursement
  REVERSED // terminal — a confirmed payment later recalled/bounced (compensating)
}

model ProviderDisbursement {
  id                       String             @id @default(cuid())
  tenantId                 String
  providerId               String
  // Relation-less pointers (satellite convention).
  settlementBatchId        String
  voucherId                String?
  status                   DisbursementStatus @default(PENDING)
  // Money: transaction amount + frozen base snapshot (never recomputed from live FX).
  amount                   Decimal            @db.Decimal(19, 4)
  currency                 String
  baseAmount               Decimal            @default(0) @db.Decimal(19, 4)
  baseCurrency             String             @default("UGX")
  fxRateRef                String? // frozen FX fact reference (where a non-base disbursement applies)
  // Method / destination — masked only, NEVER plaintext bank/mobile details (§9/D27).
  method                   String? // BANK_TRANSFER | MOBILE_MONEY | CHEQUE | RTGS | ...
  channel                  String?
  maskedDestination        String? // e.g. "***4321" — never the full account/MSISDN
  externalReference        String? // bank/channel payment reference (distinct from the internal voucher number)
  valueDate                DateTime?
  // Lifecycle actors + times (append-only in spirit; the state machine gates status).
  initiatedById            String?
  initiatedAt              DateTime?
  confirmedById            String?
  confirmedAt              DateTime?
  failedById               String?
  failedAt                 DateTime?
  reversedById             String?
  reversedAt               DateTime?
  // Failure reason — SAFE (provider-facing) vs INTERNAL are separated (§9/D27).
  failureReasonSafe        String?
  failureReasonInternal    String?
  // Compensation: a REVERSED record may point at the disbursement it reverses.
  reversalOfDisbursementId String?
  // Idempotency + reconciliation + optimistic concurrency.
  idempotencyKey           String?
  reconciliationStatus     String             @default("UNRECONCILED") // UNRECONCILED | RECONCILED | EXCEPTION
  version                  Int                @default(1)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@unique([tenantId, idempotencyKey]) // NULLs distinct in PG ⇒ keyless rows unaffected
  @@index([tenantId, settlementBatchId])
  @@index([tenantId, providerId])
  @@index([tenantId, status])
}

// PNOS F6.9 — settlement reconciliation control (§I5/I6). Stores each run + its
// watermark + the exact mismatches it found; NEVER mutates a financial fact (the
// job only reads and records exceptions for finance to investigate). Additive.
enum ReconciliationExceptionType {
  LINE_HEADER_MISMATCH // Σ line payable ≠ Σ claim payable
  CLAIM_BATCH_MISMATCH // Σ claim payable ≠ stored batch total
  VOUCHER_MISMATCH // batch total ≠ voucher amount
  MISSING_VOUCHER // a SETTLED batch has no voucher
  OVER_DISBURSED // Σ successful disbursement > batch total
  BASE_GL_MISMATCH // Σ claim base ≠ stored batch base
}

enum ReconciliationInvestigationStatus {
  OPEN
  INVESTIGATING
  RESOLVED // the underlying data was corrected out-of-band by an authorized owner
  ACCEPTED // reviewed and accepted as a known/tolerated difference
}

model SettlementReconciliationRun {
  id              String    @id @default(cuid())
  tenantId        String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  watermark       DateTime? // max settledAt scanned (for incremental repeat runs)
  batchesChecked  Int       @default(0)
  exceptionsFound Int       @default(0)
  status          String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  createdAt       DateTime  @default(now())

  @@index([tenantId, startedAt])
}

model SettlementReconciliationException {
  id                  String                            @id @default(cuid())
  tenantId            String
  runId               String
  settlementBatchId   String
  providerId          String?
  currency            String
  type                ReconciliationExceptionType
  detail              String // safe references + amounts
  expectedAmount      Decimal?                          @db.Decimal(19, 4)
  actualAmount        Decimal?                          @db.Decimal(19, 4)
  investigationStatus ReconciliationInvestigationStatus @default(OPEN)
  investigationNote   String?
  resolvedById        String?
  resolvedAt          DateTime?
  createdAt           DateTime                          @default(now())

  @@index([tenantId, runId])
  @@index([tenantId, settlementBatchId])
  @@index([tenantId, investigationStatus])
}

// PNOS F6.10 — provider payment query (§7.9, D17). A provider raises a query about a
// settlement/claim/line/disbursement; finance responds WITHOUT changing a claim decision
// (a decision dispute is an explicit reconsideration, F6.12). Additive; relation-less id
// pointers to batch/claim/line/disbursement/reconsideration (satellite convention).
enum PaymentQueryStatus {
  OPEN
  ACKNOWLEDGED
  INFORMATION_REQUIRED
  PROVIDER_RESPONDED
  RESOLVED
  REJECTED
  WITHDRAWN
  CLOSED
}

enum PaymentQueryCategory {
  MISSING_PAYMENT
  SHORT_PAYMENT
  WRONG_AMOUNT
  WRONG_REFERENCE
  DUPLICATE_PAYMENT
  UNIDENTIFIED_PAYMENT
  OTHER
}

model ProviderPaymentQuery {
  id                      String               @id @default(cuid())
  tenantId                String
  clientId                String? // read-model confinement (G2.1) where applicable
  providerId              String
  providerBranchId        String?
  settlementBatchId       String
  // optional finer targets (relation-less pointers)
  claimId                 String?
  claimLineId             String?
  disbursementId          String?
  category                PaymentQueryCategory
  discrepancyAmount       Decimal?             @db.Decimal(19, 4)
  discrepancyCurrency     String?
  providerNarrative       String
  status                  PaymentQueryStatus   @default(OPEN)
  // owners
  providerRequesterId     String?
  assignedTeam            String?
  assignedReviewerId      String?
  // SLA
  slaPolicy               String?
  slaVersion              String?
  dueAt                   DateTime?
  // linked reconsideration when a dispute is explicitly converted (F6.12 sets this)
  linkedReconsiderationId String?
  // resolution — SAFE (provider-facing) vs INTERNAL separated (§9)
  resolutionCode          String?
  resolutionExplanation   String?
  resolutionInternalNote  String?
  // idempotency + optimistic concurrency
  idempotencyKey          String?
  version                 Int                  @default(1)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  messages ProviderPaymentQueryMessage[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, settlementBatchId])
  @@index([tenantId, providerId])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
}

model ProviderPaymentQueryMessage {
  id             String               @id @default(cuid())
  tenantId       String
  paymentQueryId String
  paymentQuery   ProviderPaymentQuery @relation(fields: [paymentQueryId], references: [id])
  sequence       Int
  audience       String // SHARED (provider-visible) | INTERNAL
  eventType      String // RAISED | ACKNOWLEDGED | INFO_REQUESTED | PROVIDER_RESPONDED | RESOLVED | REJECTED | WITHDRAWN | MESSAGE
  priorStatus    String?
  newStatus      String?
  body           String? // safe exchange text
  actorType      String
  actorId        String?
  createdAt      DateTime             @default(now())

  @@unique([paymentQueryId, sequence])
  @@index([tenantId, paymentQueryId, createdAt])
}

// PNOS F7.4 — provider master-data change requests (spec §7.10). A provider
// PROPOSES an allowed profile/branch/practitioner/credential/bank/integration
// change; the active master data is NEVER mutated directly — an approved request
// calls the canonical owning service. Sensitive changes (bank) require
// maker ≠ checker + the F7.5 independent verification before activation, and the
// full sensitive value NEVER lands here (snapshot/proposed store masked values
// only). Relation-less to Provider/Tenant (plain ids) like ProviderPaymentQuery.
enum MasterDataChangeCategory {
  CONTACT
  BRANCH
  PRACTITIONER
  CREDENTIAL
  BANK
  INTEGRATION
  OTHER
}

enum MasterDataChangeStatus {
  SUBMITTED
  UNDER_REVIEW
  INFORMATION_REQUIRED
  PROVIDER_RESPONDED
  PENDING_CHECKER // sensitive: maker approved, awaiting a DISTINCT checker (maker ≠ checker)
  APPROVED // decision approved; non-sensitive are activated now, sensitive await F7.5 verified activation
  REJECTED
  WITHDRAWN
}

enum MasterDataChangeRisk {
  LOW
  MEDIUM
  HIGH // sensitive — maker ≠ checker + independent verification (bank)
}

model ProviderMasterDataChangeRequest {
  id               String                   @id @default(cuid())
  tenantId         String
  providerId       String
  providerBranchId String? // set for BRANCH-scoped changes
  category         MasterDataChangeCategory
  riskLevel        MasterDataChangeRisk     @default(LOW)

  // Masked snapshot of the CURRENT values at submit time (sensitive fields masked),
  // and the proposed new values (sensitive fields masked here — the full value is
  // handled out-of-band by the canonical owner / F7.5, never stored on this row).
  currentSnapshot     Json
  proposedValues      Json
  evidenceDocumentIds String[] @default([]) // relation-less pointers to Document
  providerNarrative   String?

  status              MasterDataChangeStatus @default(SUBMITTED)
  providerRequesterId String?
  assignedReviewerId  String?

  // Maker/checker (sensitive changes) — maker ≠ checker enforced in the service.
  makerId   String?
  makerAt   DateTime?
  checkerId String?
  checkerAt DateTime?

  // Independent verification facts for BANK changes — populated by F7.5, null here.
  verificationMethod    String?
  verificationReference String?
  verifiedById          String?
  verifiedAt            DateTime?

  // Decision — SAFE (provider-facing) vs INTERNAL separated (§9).
  decisionCode         String?
  decisionExplanation  String?
  decisionInternalNote String?

  // Activation (the canonical apply): non-sensitive on approval; sensitive in F7.5.
  effectiveAt   DateTime?
  activatedAt   DateTime?
  activatedById String?

  // SLA
  slaPolicy String?
  dueAt     DateTime?

  // Idempotency + optimistic concurrency.
  idempotencyKey String?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events ProviderMasterDataChangeEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, providerId])
  @@index([tenantId, status])
  @@index([tenantId, category])
}

model ProviderMasterDataChangeEvent {
  id              String                          @id @default(cuid())
  tenantId        String
  changeRequestId String
  changeRequest   ProviderMasterDataChangeRequest @relation(fields: [changeRequestId], references: [id])
  sequence        Int
  audience        String // SHARED (provider-visible) | INTERNAL
  eventType       String // SUBMITTED | UNDER_REVIEW | INFO_REQUESTED | PROVIDER_RESPONDED | MAKER_APPROVED | APPROVED | REJECTED | WITHDRAWN | MESSAGE
  priorStatus     String?
  newStatus       String?
  body            String? // safe exchange text
  actorType       String
  actorId         String?
  createdAt       DateTime                        @default(now())

  @@unique([changeRequestId, sequence])
  @@index([tenantId, changeRequestId, createdAt])
}

// PNOS F7.7 — provider network improvement plan (spec §12; D21 advisory). A
// human-owned plan AGREED between a named network manager and the provider:
// objectives, actions/milestones, evidence, and a SHARED-vs-INTERNAL update log.
// It is ADVISORY ONLY — it NEVER mutates a rate, tier, contract, or provider
// status (no automated sanctions; §0 prohibited). Relation-less to Provider/Tenant.
enum ImprovementPlanStatus {
  DRAFT
  ACTIVE
  ACHIEVED
  CLOSED
  CANCELLED
}

enum ImprovementActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ImprovementOwnerRole {
  NETWORK
  PROVIDER
}

model ProviderImprovementPlan {
  id                String                @id @default(cuid())
  tenantId          String
  providerId        String
  title             String
  objective         String
  // Free-text / metric-id reference to a baseline measure. F8 metrics are stubbed
  // here (§ "F8 metric definitions may be stubbed") — there is NO scoring engine.
  baselineMetricRef String?
  networkOwnerId    String? // named network manager (operator)
  providerOwnerId   String? // named provider owner
  status            ImprovementPlanStatus @default(DRAFT)
  startDate         DateTime?
  targetDate        DateTime?
  createdById       String?
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  actions ProviderImprovementAction[]
  updates ProviderImprovementUpdate[]

  @@index([tenantId, providerId])
  @@index([tenantId, status])
}

model ProviderImprovementAction {
  id                  String                  @id @default(cuid())
  tenantId            String
  planId              String
  plan                ProviderImprovementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  description         String
  ownerRole           ImprovementOwnerRole    @default(PROVIDER)
  dueDate             DateTime?
  status              ImprovementActionStatus @default(OPEN)
  evidenceDocumentIds String[]                @default([])
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([tenantId, planId])
}

model ProviderImprovementUpdate {
  id        String                  @id @default(cuid())
  tenantId  String
  planId    String
  plan      ProviderImprovementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sequence  Int
  audience  String // SHARED (provider-visible) | INTERNAL
  body      String
  actorType String
  actorId   String?
  createdAt DateTime                @default(now())

  @@unique([planId, sequence])
  @@index([tenantId, planId, createdAt])
}

// PNOS F8.2 — versioned, published provider performance score (§8.13; D21 advisory).
// A NEW model ALONGSIDE the legacy cost `ProviderScorecard` (which is left untouched,
// so its analytics readers keep working). Every score value retains its numerator,
// denominator, definition version, completeness, cohort, and source watermark, plus a
// publication/freeze state — so a provider only ever sees a PUBLISHED, complete,
// sufficiently-sampled score. This holds the F8.3 output; F8.1's PNMC-1.0 catalog is the
// authority for what each metricKey means. Relation-less to Provider/Tenant.
enum PerformanceScoreStatus {
  DRAFT // computed, not yet published to the provider
  PUBLISHED // visible to the provider when complete + meets sample + not suppressed
  FROZEN // period frozen; only a corrected republish (new publicationVersion) supersedes
}

model ProviderPerformanceScore {
  id                String   @id @default(cuid())
  tenantId          String
  providerId        String
  // "" = provider-level; a branch id = branch-level. A non-null default keeps the
  // unique key well-defined (a nullable column would treat every provider-level row
  // as distinct in Postgres and defeat the uniqueness the spec requires).
  providerBranchId  String   @default("")
  period            String // YYYY-MM
  periodStart       DateTime
  periodEnd         DateTime
  metricKey         String // e.g. "A2_clean_claim_rate" — a key from the PNMC catalog
  definitionVersion String // e.g. "PNMC-1.0"

  // provenance (F8.1 §1) — the numbers behind the value.
  numerator          Decimal  @db.Decimal(18, 4)
  denominator        Decimal  @db.Decimal(18, 4)
  value              Decimal? @db.Decimal(18, 6) // numerator/denominator, or a p50/p90 for distribution metrics
  unit               String   @default("RATE") // RATE | DAYS | HOURS | COUNT | PERCENTILE
  completeness       Decimal  @default(1) @db.Decimal(5, 4) // fraction of expected facts present (0..1)
  sampleSize         Int      @default(0) // the denominator count, for the minimum-sample rule
  meetsMinimumSample Boolean  @default(false)

  // cohort membership (the anonymized benchmark values themselves are F8.4).
  cohortKey              String? // tenant|type|tier(|facet) — the peer set this score belongs to
  suppressedForAnonymity Boolean @default(false)

  // exclusions + control totals (F8.3 records these for reconciliation/audit).
  excludedCount Int   @default(0)
  controlTotals Json? // { includedFacts, excludedFacts, numeratorCheck, ... }

  // source watermark — the deterministic marker of the frozen source-fact set + params
  // that produced this score (so a re-run over identical facts is a no-op).
  sourceWatermark String
  computedAt      DateTime @default(now())

  // publication / freeze.
  status             PerformanceScoreStatus @default(DRAFT)
  publishedAt        DateTime?
  frozenAt           DateTime?
  publicationVersion Int                    @default(1) // a corrected republish increments (F8.4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, period, providerId, providerBranchId, metricKey, definitionVersion])
  @@index([tenantId, providerId, period])
  @@index([tenantId, metricKey, period])
  @@index([tenantId, status, period])
  @@index([tenantId, cohortKey, period, metricKey])
}

// PNOS F8.4 — a frozen, anonymized cohort benchmark for one metric+period+version.
// It publishes the peer DISTRIBUTION (percentile/median/range) WITHOUT any named
// peer — the row carries no providerId, only the aggregate stats and the count of
// contributing providers (always >= the minimum-cohort threshold; a smaller cohort
// is suppressed and no row is written). A corrected republish is a NEW publication
// version (the prior remains as history). Relation-less to Tenant.
model PerformanceCohortBenchmark {
  id                String   @id @default(cuid())
  tenantId          String
  period            String
  periodStart       DateTime
  periodEnd         DateTime
  metricKey         String
  definitionVersion String
  cohortKey         String // tenant|type|tier — the anonymized peer set (NO provider ids)

  providerCount Int // distinct providers contributing (>= the minimum-cohort threshold)
  sampleSize    Int // total contributing denominator across the cohort
  unit          String @default("RATE")

  // distribution — percentile/median/range only, no named peer.
  minValue Decimal? @db.Decimal(18, 6)
  p25      Decimal? @db.Decimal(18, 6)
  median   Decimal? @db.Decimal(18, 6)
  p75      Decimal? @db.Decimal(18, 6)
  p90      Decimal? @db.Decimal(18, 6)
  maxValue Decimal? @db.Decimal(18, 6)

  // freeze + versioning.
  publicationVersion   Int      @default(1)
  publicationWatermark String
  frozenAt             DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, period, metricKey, definitionVersion, cohortKey, publicationVersion])
  @@index([tenantId, period, metricKey])
  @@index([tenantId, cohortKey, period])
}

// ─── PNOS F9 — HMS INTEGRATION CONTROL PLANE (§7.11 / §8.12) ──────────────────
// Additive control-plane schema for the HMS integration rail. These models give
// every inbound/outbound delivery a durable connection + receipt + attempt ledger
// so integration truth never lives only in memory, a queue, or an app log (D-prohibition).
//
// They are ADDITIVE and do NOT replace the legacy `IntegrationConfig` (@5205),
// which is preserved during migration (F9.2 step 5) and read-only-retired later
// (F9.9). No live path is wired here (F9.2 stop condition): the models exist,
// F9.3 administers connections, F9.4 writes durable receipts, F9.5 maps records,
// F9.6 adds retry/quarantine/sweeper. Relation-less to Tenant/Provider/Branch
// (plain String scope keys, matching the F8 performance models) — providerBranchId
// uses `""` for provider-level so branch scope stays well-defined in unique keys.

enum ProviderIntegrationMode {
  PUSH
  PULL
  BIDIRECTIONAL
}

enum ProviderIntegrationStatus {
  DRAFT
  TESTING
  ACTIVE
  PAUSED
  DISABLED
}

enum IntegrationCircuitState {
  CLOSED // healthy — deliveries flow
  OPEN // tripped — deliveries short-circuit until the cool-down elapses
  HALF_OPEN // probing — a single trial delivery decides CLOSE vs re-OPEN
}

enum IntegrationDeliveryDirection {
  INBOUND // partner → Medvex (push receipt, or a pulled batch landed durably)
  OUTBOUND // Medvex → partner (a pull request/response envelope)
}

enum IntegrationDeliveryStatus {
  RECEIVED // durable receipt created; not yet validated
  VALIDATING // auth/schema/scope/control-total checks in flight
  ACCEPTED // validated; queued for canonical mapping
  PARTIAL // some records applied, some quarantined/rejected
  REJECTED // whole delivery refused before any domain effect
  RETRYING // a retryable failure is scheduled for another attempt
  QUARANTINED // terminal/poison — parked for authorized manual remediation
  COMPLETED // every record reached a terminal per-record outcome
}

/// A configured integration channel between one facility (provider, optional
/// branch) and an external HMS/partner system. Carries a SECRET REFERENCE and a
/// credential version — never the secret itself (§7.11; the plaintext-secret
/// exposure the F9.1 inventory flagged on IntegrationConfig is closed by this
/// indirection + the F9.3 admin service).
model ProviderIntegrationConnection {
  id               String @id @default(cuid())
  tenantId         String
  // Scope keys (relation-less; validated against Provider/Branch in the F9.3 service).
  providerId       String
  providerBranchId String @default("") // "" = provider-level; a branch id = branch-scoped

  label            String // human label, e.g. "Aga Khan HMS — production"
  connectorType    String // connector family, e.g. "HMS_BATCH_V1" / "SLADE360_EDI"
  connectorVersion String                  @default("1") // adapter contract version
  mode             ProviderIntegrationMode @default(PUSH)

  // Transport safety (SSRF/allowlist enforced in F9.3/F9.7; here we hold references).
  apiBaseUrl           String? // outbound base URL (PULL/BIDIRECTIONAL); validated HTTPS + allowlist in F9.3
  endpointAllowlistRef String? // reference to the host/IP allowlist policy (not the list inline)

  // Credentials — a REFERENCE + version only. The secret material lives in the
  // secret store keyed by secretRef; this row never stores or returns it.
  secretRef         String? // opaque handle into the secret store
  credentialVersion Int     @default(1) // bumps on rotation (F9.3)

  scopes         String[] @default([]) // integration scope codes this connection may exercise
  mappingVersion String? // external→canonical mapping version (F9.5)

  // Cadence + cursor (PULL). cursor advances only past a durable accepted boundary (F9.7).
  cadence String? // e.g. cron/interval hint for the scheduler
  cursor  String? // opaque pagination/watermark cursor

  status              ProviderIntegrationStatus @default(DRAFT)
  circuitState        IntegrationCircuitState   @default(CLOSED)
  circuitOpenedAt     DateTime? // when OPEN tripped, for cool-down math (F9.6)
  consecutiveFailures Int                       @default(0) // F9.7 pull circuit threshold; reset on success

  lastSuccessAt DateTime?
  lastFailureAt DateTime?

  owners              String? // support owners (names/emails), PHI-free
  supportInstructions String? // runbook pointer, PHI-free

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries ProviderIntegrationDelivery[]
  secrets    ProviderIntegrationSecret[]

  // One live connection per (provider, branch, connector, mode) — the consistency
  // the F9.2 test asserts. providerBranchId's "" default keeps provider-level rows
  // from colliding while staying unique.
  @@unique([tenantId, providerId, providerBranchId, connectorType, mode])
  @@index([tenantId, providerId])
  @@index([tenantId, status])
  @@index([tenantId, providerId, providerBranchId])
}

/// A durable receipt for one delivery envelope (a push request, or one pulled
/// batch). Created BEFORE any domain processing (F9.4) so an accepted delivery
/// survives a queue/app failure. Idempotency is per (connection, idempotencyKey):
/// the same key + same hash replays; the same key + a different hash conflicts
/// (F9.4) — nothing mutates on either.
model ProviderIntegrationDelivery {
  id               String                        @id @default(cuid())
  tenantId         String
  connectionId     String
  connection       ProviderIntegrationConnection @relation(fields: [connectionId], references: [id])
  // Denormalized scope (matches how the codebase scopes reads); consistent with the connection.
  providerId       String
  providerBranchId String                        @default("")

  direction          IntegrationDeliveryDirection @default(INBOUND)
  businessObjectType String // CASE_SERVICE | CLAIM | PREAUTH | CASE_ACTIVITY (connector-declared)

  externalBatchRef      String? // the partner's batch id (e.g. "AGA-2026-07-03")
  externalRef           String? // a finer partner reference when present
  idempotencyKey        String // caller-stable key; unique per connection
  normalizedPayloadHash String // hash of the normalized body — detects same-key/different-body conflict

  // Control totals (asserted vs applied) — the reconciliation substrate (F9.5/F9.6).
  recordCount      Int? // records the envelope claims
  amountTotal      Decimal? @db.Decimal(19, 4) // asserted monetary total, where relevant
  appliedCount     Int      @default(0)
  rejectedCount    Int      @default(0)
  quarantinedCount Int      @default(0)
  replayedCount    Int      @default(0)

  status IntegrationDeliveryStatus @default(RECEIVED)

  // Canonical linkage — receipt/result references into the domain rails (F9.5).
  canonicalReceiptRef String? // e.g. a ClaimIntakeReceipt id
  canonicalResultRef  String? // e.g. an aggregate result marker

  // Retry / durable lease (F9.6). Attempts are leased so a crashed worker's work
  // is reclaimed after the lease expires without double-applying.
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(5)
  nextAttemptAt    DateTime?
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  quarantineReason String? // safe, PHI-free reason when QUARANTINED

  receivedAt  DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attempts      ProviderIntegrationAttempt[]
  recordResults ProviderIntegrationRecordResult[]

  // The delivery idempotency the F9.2 test asserts: one delivery per key per connection.
  @@unique([connectionId, idempotencyKey])
  @@index([tenantId, providerId, status])
  @@index([connectionId, status])
  @@index([status, nextAttemptAt]) // sweeper: retry-due / abandoned deliveries (F9.6)
  @@index([tenantId, businessObjectType, receivedAt])
}

/// Per-record outcome inside a delivery (a batch has many). Gives each inbound
/// record its own durable receipt + canonical reference + idempotency, so a mixed
/// batch conserves accepted/rejected/quarantined counts (F9.5) and a same-record
/// replay is a no-op. Never stores a raw clinical body — only a hash + a safe reason.
model ProviderIntegrationRecordResult {
  id         String                      @id @default(cuid())
  tenantId   String
  deliveryId String
  delivery   ProviderIntegrationDelivery @relation(fields: [deliveryId], references: [id])

  recordIndex        Int // position within the delivery envelope
  recordHash         String // hash of the normalized record — the per-record idempotency key
  businessObjectType String

  // Outcome vocabulary mirrors the existing hms-batch/import dispositions:
  // APPLIED | REPLAYED | LINKED | UNMATCHED | REJECTED | QUARANTINED.
  outcome String

  // Canonical linkage — what this record produced in the domain (no raw payload).
  canonicalEntityType String? // e.g. "CaseServiceEntry"
  canonicalEntityId   String?
  canonicalReceiptRef String?
  amount              Decimal? @db.Decimal(19, 4) // for amount conservation

  safeReason String? // PHI-free reason for UNMATCHED/REJECTED/QUARANTINED

  createdAt DateTime @default(now())

  // A record applies at most once per delivery — the per-record idempotency guard.
  @@unique([deliveryId, recordHash])
  @@index([tenantId, outcome])
  @@index([deliveryId])
}

/// One processing attempt against a delivery. The append-only attempt ledger:
/// ordered per delivery, carries a SAFE result class + error code only — never a
/// raw clinical body, a header, or a secret (§7.11 / D-prohibition).
model ProviderIntegrationAttempt {
  id         String                      @id @default(cuid())
  deliveryId String
  delivery   ProviderIntegrationDelivery @relation(fields: [deliveryId], references: [id])

  attemptNumber Int // 1-based; ordered + unique per delivery

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Result classification (safe, connector-agnostic):
  // SUCCESS | TIMEOUT | HTTP_5XX | HTTP_4XX | SCHEMA | POISON | LEASE_EXPIRED.
  resultClass   String?
  httpStatus    Int? // transport status, when applicable
  safeErrorCode String? // safe, catalogued code — NOT a raw error/body
  retryable     Boolean   @default(false)
  nextAttemptAt DateTime?

  responseReceiptRef String? // reference to a stored response receipt (no raw body inline)

  createdAt DateTime @default(now())

  // Attempt ordering the F9.2 test asserts: attempts are unique + ordered per delivery.
  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId])
}

/// PNOS F9.3 — secret-reference storage for a connection's credential. The
/// connection row holds only a pointer (secretRef → the ACTIVE row here) +
/// credentialVersion; the secret MATERIAL never lives on the connection and is
/// never returned by a read. Only a bcrypt hash is stored (mirrors ProviderApiKey)
/// — the plaintext is revealed exactly once at generation/rotation. Rotation
/// retires the prior version (overlap-safe) and mints a new one. Reversible
/// storage for an OUTBOUND partner-supplied credential is deferred to F9.7 (when
/// the contracted auth scheme is known); this table serves the locally-generated
/// signing secret, verified by hash.
model ProviderIntegrationSecret {
  id           String                        @id @default(cuid())
  tenantId     String
  connectionId String
  connection   ProviderIntegrationConnection @relation(fields: [connectionId], references: [id])

  version    Int // 1-based; bumps on rotation
  secretHash String // bcrypt hash of the plaintext — never the plaintext, never returned
  status     String @default("ACTIVE") // ACTIVE | RETIRED

  createdById String?
  createdAt   DateTime  @default(now())
  retiredAt   DateTime?

  @@unique([connectionId, version])
  @@index([connectionId, status])
}

// ─── PNOS F10 — CAPITATION / PMPM EXTENSION (§7.13 / D24) ─────────────────────
// A SEPARATE governed ledger (D24): frozen eligible-life + rate snapshots, a
// dedicated reconciliation, zero-pay capitated encounters that never settle as FFS.
// ADDITIVE + INERT — nothing computes/activates before the F10.1 CAP-1.0 six-owner
// sign-off + the F10.7 pilot (PNO-CAP-008). Relation-less to Tenant/Provider (plain
// String scope keys, matching the F8/F9 convention); internal relations only
// (period → arrangement, adjustment/eligible-life → period). Reuses the existing
// finance owners (PaymentVoucher/JournalEntry/ProviderDisbursement) by reference —
// capitation adds NO new pricing/payment engine (§8.14).

enum CapitationRateBasis {
  PMPM // per-member-per-month × frozen lives
  PER_VISIT // per counted valid visit
  FIXED_PERIOD // flat per-period pool
}

enum CapitationArrangementStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum CapitationPeriodStatus {
  DRAFT // snapshot may still recompute
  CALCULATED // accrual computed, not yet frozen
  FROZEN // immutable snapshot + accrual (maker/checker)
  PAID // disbursement recorded
  CLOSED // reconciled + signed off
  REOPENED // governed reopen (supersedes with a new calculation version)
}

/// Effective-dated capitation terms for one scope. Non-overlapping ACTIVE ranges
/// per (provider, branch, client, group, package, rateBasis).
model CapitationArrangement {
  id               String  @id @default(cuid())
  tenantId         String
  providerId       String
  providerBranchId String  @default("") // "" = all branches
  clientId         String?
  groupId          String?
  packageId        String?

  label     String
  rateBasis CapitationRateBasis @default(PMPM)
  rate      Decimal             @db.Decimal(19, 4)
  currency  String              @default("UGX")
  cadence   String              @default("MONTHLY")

  coveredServices Json? // service scope covered by the pool
  ffsCarveOuts    Json? // services explicitly carved out to ordinary FFS

  eligibilityDefinitionVersion String // e.g. CAP-1.0 — frozen onto each period
  governingContractId          String? // link the governing contract (§7.13 step 2)
  glPolicyRef                  String? // GL/finance treatment reference

  status        CapitationArrangementStatus @default(DRAFT)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  createdById   String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  periods CapitationPeriod[]

  @@index([tenantId, providerId, status])
  @@index([tenantId, providerId, providerBranchId, effectiveFrom])
}

/// One append-only period ledger row per (arrangement, period). Carries the frozen
/// eligible-life count + control hash, the accrual, the conservation balances, and
/// references to the finance owners that actually pay it.
model CapitationPeriod {
  id            String                @id @default(cuid())
  tenantId      String
  arrangementId String
  arrangement   CapitationArrangement @relation(fields: [arrangementId], references: [id])

  period      String // YYYY-MM
  periodStart DateTime
  periodEnd   DateTime

  // eligible-life snapshot (F10.3 populates; frozen at freeze).
  snapshotInstant         DateTime?
  eligibleLifeCount       Int       @default(0)
  eligibleLifeControlHash String?
  definitionVersion       String

  // accrual + conservation (F10.4 computes; Decimal only).
  rate            Decimal @db.Decimal(19, 4)
  grossAccrual    Decimal @default(0) @db.Decimal(19, 4)
  adjustmentTotal Decimal @default(0) @db.Decimal(19, 4)
  amountPayable   Decimal @default(0) @db.Decimal(19, 4)
  amountPaid      Decimal @default(0) @db.Decimal(19, 4)
  openingBalance  Decimal @default(0) @db.Decimal(19, 4)
  closingBalance  Decimal @default(0) @db.Decimal(19, 4)
  controlTotals   Json?

  calculationVersion Int                    @default(0) // a reopen/recalc increments
  status             CapitationPeriodStatus @default(DRAFT)
  frozenAt           DateTime?
  frozenById         String?
  approvedAt         DateTime?
  approvedById       String?

  // finance owner references (F10.6) — capitation reuses these, never re-implements.
  voucherId      String?
  disbursementId String?
  journalEntryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adjustments   CapitationAdjustment[]
  eligibleLives CapitationEligibleLife[]

  @@unique([arrangementId, period])
  @@index([tenantId, status, period])
}

/// Append-only positive/negative adjustment. A correction after freeze is an
/// adjustment (or a governed reopen) — NEVER a silent rewrite (PNO-CAP-003).
model CapitationAdjustment {
  id       String           @id @default(cuid())
  tenantId String
  periodId String
  period   CapitationPeriod @relation(fields: [periodId], references: [id])

  category     String // RETRO_ELIGIBILITY | RATE_CORRECTION | CLAWBACK | INCENTIVE | RECONCILIATION
  amount       Decimal   @db.Decimal(19, 4) // signed: + charge, − credit
  evidenceRef  String?
  reason       String?
  actorId      String?
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now()) // append-only — no updatedAt

  @@index([periodId])
  @@index([tenantId, category])
}

/// The frozen eligible-life roster (F10.3). One row per (period, member) recording
/// inclusion + the reason + the coverage source version. Carries NO clinical detail.
model CapitationEligibleLife {
  id       String           @id @default(cuid())
  tenantId String
  periodId String
  period   CapitationPeriod @relation(fields: [periodId], references: [id])

  memberId              String
  included              Boolean
  reasonCode            String // COVERED | NOT_ACTIVE | NO_COVERAGE_ON_SNAPSHOT_DAY | OUT_OF_SCOPE | CARVE_OUT_ONLY
  coverageSourceVersion String?

  createdAt DateTime @default(now())

  @@unique([periodId, memberId])
  @@index([periodId, included])
  @@index([tenantId, memberId])
}

enum CapitationFunding {
  INCLUDED // covered by the pool — zero FFS payable, paid via the capitation accrual
  CARVE_OUT // explicitly FFS-carved — ordinary canonical claim + settlement
}

/// F10.5 — the funding decision for one encounter/claim line under a capitation
/// arrangement. An INCLUDED line is zero FFS payable + linked to the period for
/// utilization; a CARVE_OUT line flows ordinary FFS. A line links AT MOST ONCE
/// (@@unique) — the same service can never be both without an explicit split.
/// Relation-less to the arrangement/period (plain String ids); NO clinical detail.
model CapitationEncounterLink {
  id            String  @id @default(cuid())
  tenantId      String
  arrangementId String
  periodId      String? // the linked period (INCLUDED); null until known

  memberId         String
  providerId       String
  providerBranchId String   @default("")
  serviceDate      DateTime

  entityType String // CLAIM_LINE | CASE_SERVICE_ENTRY
  entityId   String
  funding    CapitationFunding
  reason     String?

  createdById String?
  createdAt   DateTime @default(now())

  @@unique([entityType, entityId]) // one funding decision per line — no double-count
  @@index([tenantId, arrangementId])
  @@index([periodId])
  @@index([memberId, serviceDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// DIAGNOSIS GATE (DG) — clinical protocol-adherence gating
// Execution plan: /DIAGNOSIS_GATE_EXECUTION_PLAN.md · Semantics:
// docs/diagnosis-gate/DIAGNOSIS_GATE_SPEC.md
//
// ALL ADDITIVE. Nothing here changes existing behaviour: the CLINICAL stage is
// record-only until AutoAdjudicationPolicy.clinicalGateEnabled is deliberately
// switched on (DG-D4), and clinical content exists only once a pack has been
// imported, approved by a checker, and activated (DG-D6).
//
// Clinical content is NEVER authored in code or seeds — every row traces to a
// vendored clinical-team workbook (docs/diagnosis-gate/source/). A missing or
// ambiguous source value is an import validation error, never a default (DG-D7).
// ═══════════════════════════════════════════════════════════════════════════

enum ClinicalCodeSystem {
  ICD10
  ICD11
}

enum ClinicalMappingProvenance {
  AUTHORED // stated by the clinical team in the source workbook
  GENERATED_CROSSWALK // derived via the official WHO ICD-10↔11 crosswalk (C1.4), awaiting clinical confirmation
}

enum ClinicalLabLinkType {
  SUPPORTED // R2: this test is clinically supported by this condition
  CONFIRMATORY // R4: this test confirms this condition
}

enum ClinicalAliasMatchType {
  CPT_CODE
  SERVICE_CODE
  NORMALIZED_NAME
}

enum ClinicalProtocolPackStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
  DEACTIVATED
}

enum ClinicalVerdict {
  TRUE_POSITIVE
  FALSE_POSITIVE
  UNSURE
}

/// One immutable, versioned import of the ENTIRE clinical content set. Exactly one
/// row per tenant may have isActive=true (enforced in ProtocolPackService.activatePack,
/// which supersedes the prior active row in the same transaction).
model ClinicalProtocolPack {
  id       String                     @id @default(cuid())
  tenantId String
  version  Int
  status   ClinicalProtocolPackStatus @default(DRAFT)
  isActive Boolean                    @default(false)

  /// Provenance back to docs/diagnosis-gate/source/
  sourceFileName String
  /// sha256 of the canonical pack JSON (not the xlsx) — detects re-import of identical content
  sourceChecksum String
  notes          String?

  /// Import-time validation summary (counts, warnings) — safe machine-readable only
  validationStats Json?

  createdById        String?
  approvalRequestId  String?
  approvedById       String?
  approvedAt         DateTime?
  /// Approval and activation are SEPARATE acts: a checker approves the content, then a
  /// human deliberately puts it in force. Both actors are recorded.
  activatedById      String?
  activatedAt        DateTime?
  supersededAt       DateTime?
  /// Safety valve — withdrawing a pack leaves NO active pack, and the CLINICAL stage
  /// then passes every claim (NO_ACTIVE_PACK). Reason is mandatory.
  deactivatedById    String?
  deactivationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups      ClinicalInterventionGroup[]
  memberships ClinicalCodeMembership[]
  labRules    ClinicalLabRule[]
  links       ClinicalLabRuleGroupLink[]
  aliases     ClinicalLineAlias[]

  @@unique([tenantId, version])
  @@index([tenantId, isActive])
  @@index([tenantId, status])
}

/// The canonical unit the gate reasons about (DG-D2): a set of diagnoses that call for
/// similar clinical intervention. ICD codes are memberships INTO a group, never keys.
model ClinicalInterventionGroup {
  id     String               @id @default(cuid())
  packId String
  pack   ClinicalProtocolPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  groupCode   String // "CIG-001" — the stable key; names are display only
  name        String
  description String?

  /// DG-D8: a category rather than a diagnosis (e.g. "Atopy" spans 109 ICD codes).
  /// Permanently barred from live routing; the UI disables the toggle.
  isCatchAll       Boolean @default(false)
  enabledForShadow Boolean @default(true)
  enabledForLive   Boolean @default(false)

  /// R4 lookback: how far back a confirmatory test may sit on an earlier claim.
  /// null = the confirmatory test must be on THIS claim.
  confirmationLookbackHours Int?

  /// Row reference in the source workbook (audit trail)
  sourceRow String?

  memberships ClinicalCodeMembership[]
  links       ClinicalLabRuleGroupLink[]

  @@unique([packId, groupCode])
  @@index([packId])
}

/// An ICD code (either system — DG-D3) belonging to an intervention group.
model ClinicalCodeMembership {
  id     String               @id @default(cuid())
  packId String
  pack   ClinicalProtocolPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  groupId String
  group   ClinicalInterventionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  codeSystem ClinicalCodeSystem
  /// Normalised at import: uppercase, trimmed. Stored exactly as looked up.
  code       String
  provenance ClinicalMappingProvenance @default(AUTHORED)
  note       String?

  @@unique([groupId, codeSystem, code])
  /// The R1 resolution path: pack + system + code → group
  @@index([packId, codeSystem, code])
}

/// A billable test with its clinical gating rules (R2/R3/R4 inputs).
model ClinicalLabRule {
  id     String               @id @default(cuid())
  packId String
  pack   ClinicalProtocolPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  testCode   String // "LAB003"
  testName   String
  department String?

  /// R2 applies only when true — tests reasonably ordered without a stated diagnosis
  /// are never flagged for incompatibility.
  requiresDiagnosis Boolean

  /// R3 window. null = no repeat control for this test.
  repeatWindowHours Int?

  /// Provider-facing text, verbatim from the workbook's Failure_Message column.
  failureMessage String
  auditRule      String?
  sourceRow      String?

  links   ClinicalLabRuleGroupLink[]
  aliases ClinicalLineAlias[]

  @@unique([packId, testCode])
  @@index([packId])
}

/// test ↔ condition relationship: SUPPORTED (R2) or CONFIRMATORY (R4).
model ClinicalLabRuleGroupLink {
  id     String               @id @default(cuid())
  packId String
  pack   ClinicalProtocolPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  labRuleId String
  labRule   ClinicalLabRule @relation(fields: [labRuleId], references: [id], onDelete: Cascade)

  groupId String
  group   ClinicalInterventionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  linkType ClinicalLabLinkType

  @@unique([labRuleId, groupId, linkType])
  @@index([packId, groupId])
  @@index([packId, linkType])
}

/// How a billed claim line is recognised as a given test. Without aliases the rules
/// are inert on real claims — C1.5 measures coverage and feeds unmatched descriptions
/// back to the clinical team.
model ClinicalLineAlias {
  id     String               @id @default(cuid())
  packId String
  pack   ClinicalProtocolPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  labRuleId String
  labRule   ClinicalLabRule @relation(fields: [labRuleId], references: [id], onDelete: Cascade)

  matchType ClinicalAliasMatchType
  /// Normalised at import: uppercase, trimmed, whitespace collapsed.
  value     String

  /// One alias value resolves to at most one test per pack — an ambiguous alias is an
  /// import validation error, not a runtime coin-flip.
  @@unique([packId, matchType, value])
  @@index([labRuleId])
}

/// A clinician's judgement on a recorded rule hit during the shadow campaign (C4.2).
/// These verdicts produce the sampled false-positive rate that gates go-live (G-C4).
model ClinicalShadowVerdict {
  id       String @id @default(cuid())
  tenantId String
  claimId  String

  ruleCode  String // "R1" | "R2" | "R3" | "R4"
  routeCode String // the CLINICAL_* code recorded on the stage

  verdict ClinicalVerdict
  note    String?

  reviewedById String
  createdAt    DateTime @default(now())

  @@unique([claimId, ruleCode, reviewedById])
  @@index([tenantId, ruleCode, verdict])
  @@index([tenantId, createdAt])
}

/// WP-B1 — bulk-import safety ledger. One row per CONFIRMED member/roster import
/// run (admin `MEMBERS_ADMIN` lane and HR `HR_ENDORSEMENT` lane).
///
/// Two guarantees hang off this table:
///   1. IDEMPOTENCY (B-011). `idempotencyKey` = sha256 of (lane + tenant + group +
///      the canonical content of the submitted rows). The `@@unique([tenantId,
///      idempotencyKey])` makes re-uploading the SAME file for the SAME group a
///      deterministic no-op — the confirm action reserves this row first, so a
///      concurrent duplicate submit loses the race on the unique and returns the
///      winner's recorded result instead of importing everything twice.
///   2. DURABLE REJECT LIST. `rejects` persists the failed-row list (row, name,
///      reason) that used to live only in ephemeral React state and vanished on
///      navigation; it is downloadable after the fact.
///
/// Relation-free by design: this is a purely ADDITIVE model that touches no
/// existing model (no back-relations added elsewhere). `tenantId`/`groupId`/
/// `createdBy` are plain scalar scope keys.
model ImportBatch {
  id             String   @id @default(cuid())
  tenantId       String
  groupId        String
  lane           String // "MEMBERS_ADMIN" | "HR_ENDORSEMENT"
  idempotencyKey String // sha256(lane + tenant + group + canonical row content)
  fileName       String?
  totalRows      Int      @default(0)
  importedCount  Int      @default(0)
  failedCount    Int      @default(0)
  rejects        Json     @default("[]") // [{ row, name, error }] — durable reject list
  createdBy      String? // acting user id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, groupId])
  @@index([tenantId, createdAt])
}
